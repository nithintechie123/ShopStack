# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopstack
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# JWT Configuration
SHOPSTACK_JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
SHOPSTACK_JWT_EXPIRATION=86400000

# Razorpay Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_address
SPRING_MAIL_PASSWORD=your_email_app_password

# Cloudinary Storage Configuration
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name